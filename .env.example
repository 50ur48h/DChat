# data-agent — local configuration template.
#
# Copy to `.env` and edit (`make env` does it for you). `.env` is gitignored and
# must NEVER be committed. Secrets live in exactly three places (plan §1.4): a
# developer's local `.env`, GitHub Actions secrets/environments, and — from
# Phase 12 — Azure Key Vault.
#
# Every value below is fake and local-only: these passwords protect containers
# bound to localhost that hold generated demo data. Nothing here is a real
# credential, and nothing here may ever become one.
#
# Two rules this file is checked against by `scripts/check_env.sh` (B-090):
#
#   * **A key here reaches the container, or something says why not.** B-086 was
#     a variable every developer had and no service was given — the product ran
#     for a phase with an embedding model it never loaded. Adding a key means
#     passing it in `ops/docker-compose.yml` or naming it in that script's
#     HOST_ONLY declaration with the reason it stays on the host.
#   * **`KEY=` means unset, not empty.** A key with nothing after the `=`, here
#     or in your `.env`, falls back to the application default — which is what
#     lets compose pass every setting without copying the defaults beside them.

# ---------------------------------------------------------------------------
# Phase 0 — API service
# ---------------------------------------------------------------------------
# local | ci | dev | prod
ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
API_PORT=8000
# GIT_SHA is baked into the image at build time; leave unset locally.

# ---------------------------------------------------------------------------
# Phase 2 — authentication
# ---------------------------------------------------------------------------
# dev | entra
AUTH_MODE=dev
# every accepted token must claim this
OIDC_AUDIENCE=dataagent-api
# where the dev issuer publishes its keys
DEV_ISSUER_URL=http://localhost:8000/dev

# For AUTH_MODE=entra. OIDC_AUTHORITY is where the discovery document lives;
# the expected `iss` is then read from that document rather than configured,
# because for an Entra external tenant the two hosts differ and the same
# tenant also answers on login.microsoftonline.com with a different issuer.
# Leave OIDC_ISSUER unset unless you have a reason to pin it.
# OIDC_AUTHORITY=https://<domain-prefix>.ciamlogin.com/<tenant-id>/v2.0
# Comma-separated: an Entra v2 access token carries the resource's client-ID
# GUID as `aud`, a v1 token carries its api:// URI. Both name the same app
# registration, so list both and the token version stops mattering.
# OIDC_AUDIENCE=api://<dataagent-api-client-id>,<dataagent-api-client-id>
# OIDC_ISSUER=

# Web sign-in (WP2.3). NEXT_PUBLIC_* is inlined into the browser bundle, so
# only ever put public identifiers here — never a client secret.
# NEXT_PUBLIC_AUTH_MODE=entra
# NEXT_PUBLIC_ENTRA_AUTHORITY=https://<domain-prefix>.ciamlogin.com/<tenant-id>
# NEXT_PUBLIC_ENTRA_CLIENT_ID=<spa-client-id>
# NEXT_PUBLIC_API_SCOPE=api://<dataagent-api-client-id>/access_as_user

# ---------------------------------------------------------------------------
# Phase 0 — web app
# ---------------------------------------------------------------------------
# where the *browser* reaches the API
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000

# ---------------------------------------------------------------------------
# Phase 0 — platform database (compose service `platform-pg`)
# Holds tenants, catalog, runs and events from Phase 1 onward.
# ---------------------------------------------------------------------------
PLATFORM_DB_NAME=dataagent
PLATFORM_DB_USER=dataagent
PLATFORM_DB_PASSWORD=local_dev_only_change_me
PLATFORM_DB_PORT=5432

# Two roles, on purpose (architecture Part 6.3):
#   DATABASE_URL      owns the schema and runs migrations. Alembic only.
#   APP_DATABASE_URL  what the API connects as: dataagent_app, which is not a
#                     superuser, cannot BYPASSRLS, and owns nothing. Created
#                     by migration 0002; given its password by `make db.setup`.
# Inside compose the host is `platform-pg` rather than `localhost`.
DATABASE_URL=postgresql+asyncpg://dataagent:local_dev_only_change_me@localhost:5432/dataagent
APP_DB_PASSWORD=local_dev_only_change_me_app
APP_DATABASE_URL=postgresql+asyncpg://dataagent_app:local_dev_only_change_me_app@localhost:5432/dataagent

# ---------------------------------------------------------------------------
# Phase 0 — pizza demo database (compose service `seed-pizza-pg`)
# Stands in for a customer's database. `make seed` populates it.
# ---------------------------------------------------------------------------
SEED_PIZZA_DB=pizza
SEED_PIZZA_USER=pizza
SEED_PIZZA_PASSWORD=local_dev_only_change_me
SEED_PIZZA_HOST=localhost
SEED_PIZZA_PORT=6543

# The login a data source should actually be registered with: `make seed`
# creates it with CONNECT, USAGE and SELECT and nothing else, so registering it
# can honestly report readonly_verified. The owner login above exists to build
# the fixture, and should never be handed to the platform.
SEED_PIZZA_READONLY_USER=pizza_readonly
SEED_PIZZA_READONLY_PASSWORD=local_dev_only_change_me_ro

# ---------------------------------------------------------------------------
# F&B demo database (compose service `seed-fnb-pg`)
# A real operator's warehouse, loaded verbatim from the SQLite file they
# shipped. `make seed.fnb SQLITE=<path>` populates it. Kept entirely separate
# from the pizza fixture, whose numbers the Phase 9 evals depend on.
# ---------------------------------------------------------------------------
SEED_FNB_DB=fnb
SEED_FNB_USER=fnb
SEED_FNB_PASSWORD=local_dev_only_change_me
SEED_FNB_HOST=localhost
SEED_FNB_PORT=6544

# The login the data source is registered with: read, and nothing else.
SEED_FNB_READONLY_USER=fnb_readonly
SEED_FNB_READONLY_PASSWORD=local_dev_only_change_me_ro

# ---------------------------------------------------------------------------
# Phase 3 — where data-source credentials are kept (DECISIONS D-001)
#
# A customer database password never enters the platform database. It is
# encrypted with LOCAL_SECRETS_KEY and the ciphertext lives in ops/.secrets/,
# which is gitignored; the platform database holds only a pointer to it.
#
# The key is GENERATED, never chosen — `make secrets.key` prints a fresh line to
# paste below. Leave it empty and the API still boots and still serves /healthz;
# only the data-source routes refuse, and they say exactly this.
#
# In production this whole backend is refused at startup: Azure Key Vault takes
# over behind the same interface in WP12.2.
# ---------------------------------------------------------------------------
# local | keyvault
SECRETS_BACKEND=local
LOCAL_SECRETS_KEY=
# Optional. Defaults to ops/.secrets/secrets.json beside this file.
# LOCAL_SECRETS_PATH=

# ---------------------------------------------------------------------------
# Phase 3 — encryption to customer databases (B-013)
#
# A data source whose address is not on this machine must use TLS. Loopback and
# 'localhost' always count as this machine; TLS_LOCAL_HOSTS adds names that only
# exist inside a container network, where no certificate could match anyway.
# Compose sets it to the demo databases; leave it empty on the host.
#
# TLS_MODE accepts only require | verify-ca | verify-full — there is no setting
# that sends a customer's credentials to a remote database in the clear. Note
# that 'require' encrypts without checking the server's certificate; the verify
# modes are the ones that authenticate the far end, and they need a CA the
# server's certificate chains to (TLS_CA_FILE, or the system trust store).
#
# In prod nothing counts as local and TLS_MODE_LOCAL is ignored entirely.
# ---------------------------------------------------------------------------
# require | verify-ca | verify-full
TLS_MODE=require
# disable | prefer | require | verify-ca | verify-full — local addresses only
TLS_MODE_LOCAL=prefer
# comma-separated extra hostnames that count as local
TLS_LOCAL_HOSTS=
# PEM bundle for the verify-* modes. Unset means the system trust store.
# TLS_CA_FILE=

# ---------------------------------------------------------------------------
# Phase 3 — SQL Server demo database (compose profile `mssql`)
#
#   make up.mssql     start it (the image is ~1.5 GB on first pull)
#   make seed.mssql   build the pizza schema and data inside it
#
# Passwords must satisfy the SQL Server policy: 8+ characters from three of
# uppercase, lowercase, digits and symbols.
# ---------------------------------------------------------------------------
MSSQL_SA_PASSWORD=Local_dev_only_1
MSSQL_PORT=1433
MSSQL_DB=pizza

# The login to register the SQL Server data source with: `make seed.mssql`
# creates it as db_datareader with INSERT, UPDATE, DELETE, ALTER and CREATE
# TABLE explicitly denied, so registering it reports readonly_verified. sa
# builds the fixture and should never be handed to the platform.
MSSQL_PIZZA_READONLY_USER=pizza_readonly
MSSQL_PIZZA_READONLY_PASSWORD=Local_dev_only_ro_1

# ---------------------------------------------------------------------------
# Phase 5 — what one query may cost, and how long its answer is kept
#
# Every query the agent runs is bounded twice: the row cap is written into the
# SQL, so the customer's engine stops early, and it bounds the read as well.
# A caller may ask for fewer rows and never for more.
#
# Results are kept as files under ARTIFACTS_PATH, one directory per
# organization, and the rows in them have already been masked — there is no
# unmasked copy anywhere. Azure Blob replaces this in Phase 12 behind the same
# interface, exactly as Key Vault replaces the local secrets backend.
# ---------------------------------------------------------------------------
# DAL_MAX_ROWS=1000
# DAL_TIMEOUT_SECONDS=30
# ARTIFACTS_PATH=ops/artifacts
# Retention is a promise to the customer, so it is written onto each row.
# ARTIFACT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Phase 6 — which model does which job (architecture 4.9, 8.3)
#
# No call site in this codebase names a model. Callers name a ROLE, roles map to
# a TIER, and tiers map to a model per provider. That indirection is the biggest
# cost lever in the product: moving `observe` from strong to small changes what
# a run costs without touching agent code.
#
#   roles  intake  observe  plan  sql  critic  compose
#   tiers  small   mid      strong
#
# LLM_PROVIDERS is ordered — the first is primary, the rest are the fallback
# chain used when a provider fails with something worth retrying elsewhere.
#
# Model ids are configuration and this build ships NO defaults, on purpose: a
# model id compiled into a release is stale within months, and a stale one
# either 404s or quietly bills for the wrong tier. The ids below were verified
# against a live account with GET /v1/models before being written here — do the
# same before changing them; a pricing page is not proof your key can use a model.
#
# Only `openai` exists as a provider today. `anthropic` is the second provider
# the architecture calls for and is B-029; the chain below is written as if it
# were here, and resolution will fail loudly until it is.
# ---------------------------------------------------------------------------
# comma-separated, most preferred first
LLM_PROVIDERS=openai
# JSON: provider -> tier -> model id
LLM_MODELS={"openai":{"small":"gpt-5.6-luna","mid":"gpt-5.6-terra","strong":"gpt-5.6-sol"}}
# JSON: role -> tier. Only the roles you want to move; the rest keep arch 4.9's
# map (intake/observe/critic small, compose mid, plan/sql strong).
#
# For demos and local work, put `compose` on small too. Do NOT put `plan` or
# `sql` there: the DAL refuses SQL it cannot ground, so weaker SQL does not buy
# a cheap wrong answer — it buys a refusal, a repair round-trip and another
# billed call. Small-tier SQL is a false economy.
LLM_ROLE_MAP={"compose":"small"}
# JSON: model id -> USD per MILLION tokens. A model with no price here is
# recorded with a NULL cost, which means unpriced — never free. Verified
# 2026-08-14; re-check when you change a model id.
#
# **The embedding model belongs here too** (B-073). Since embedding a query is
# charged to the run that asked, an unpriced embedding model under
# LLM_RUN_COST_LIMIT_USD is refused the same way any other unpriced model is —
# so leaving it out does not make searches cheaper, it makes every capped run
# lose its vector arm and fall back to wording alone. Embeddings have no output
# tokens, so the output price is 0.
LLM_PRICES={"gpt-5.6-luna":{"input":0.20,"output":1.20},"gpt-5.6-terra":{"input":2.00,"output":12.00},"gpt-5.6-sol":{"input":5.00,"output":30.00},"text-embedding-3-small":{"input":0.02,"output":0.00}}

# ---------------------------------------------------------------------------
# Phase 6 — spending ceilings
#
# A hard cap on what ONE run may spend, checked before every call against what
# that run has already recorded. Unset means no ceiling, which is right for a
# person asking one question and wrong for an eval sweep or an agent loop.
# A full research run is estimated at $0.30-0.50, so $2 leaves generous headroom
# while still stopping a runaway.
#
# An unpriced model records a NULL cost, which no ceiling can count. When a cap
# is set, such a call is refused rather than waved through — a ceiling that
# cannot see what it is spending is not a ceiling. Set the second variable false
# to accept that risk knowingly.
# ---------------------------------------------------------------------------
LLM_RUN_COST_LIMIT_USD=2.00
# LLM_REFUSE_UNPRICED_WHEN_CAPPED=true

# Provider keys are real secrets: never commit one, and note that CI never uses
# them — the whole suite runs against the FakeLLM.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Phase 10 — embeddings
#
# The same OpenAI account as the chat models (D-017): one key, one bill, one
# place to rotate. `OPENAI_API_KEY` above is what this uses; there is no second
# key variable, because a second key for the same provider is a second thing to
# forget to rotate.
#
# EMBEDDINGS_MODEL has no default in code, for the same reason LLM_MODELS has
# none (D-017): a model id compiled into a release is stale within months, and a
# stale one either 404s or returns vectors of a width the column will not accept.
# Verify the id against the account before setting it — `GET /v1/models` — which
# is B-027's habit, and check the width by embedding one short string.
#
# text-embedding-3-small returns 1536 dimensions, which is the width revision
# 0016 fixed for knowledge_chunks.embedding. Verified against the live account on
# 2026-08-17. Changing the model to one of a different width needs a migration,
# not only a config edit, and the API asserts the two agree at startup.
#
# **Leaving these unset is a supported state, not a broken one.** With no model
# configured nothing is embedded, documents are searchable by wording alone, and
# every search says so rather than pretending it looked for meaning (D-031).
# Setting them later needs no migration: re-index each document and the vectors
# are filled in from the original bytes.
# ---------------------------------------------------------------------------
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536
# EMBEDDINGS_BATCH=64
