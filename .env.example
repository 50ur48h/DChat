# data-agent — local configuration template.
#
# Copy to `.env` and edit. `.env` is gitignored and must NEVER be committed.
# Secrets live in exactly three places (plan §1.4): a developer's local `.env`,
# GitHub Actions secrets/environments, and — from Phase 12 — Azure Key Vault.
# Every value below is fake. The local stack boots with these defaults as-is.

# ---------------------------------------------------------------------------
# Phase 0 — API service
# ---------------------------------------------------------------------------
ENV=local                                  # local | ci | dev | prod
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=http://localhost:3000         # browser origins allowed to call the API
# GIT_SHA is baked into the image at build time; leave unset locally.

# ---------------------------------------------------------------------------
# Phase 0 — web app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000  # where the browser reaches the API
